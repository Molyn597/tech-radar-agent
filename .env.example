# Environment Configuration Example for Tech-Radar Agent
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=-100xxxxxxxxxx
TELEGRAM_THREAD_ID=1
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional — separate thread for --evaluate architecture-proposal summaries.
# If unset, proposal summaries are simply not sent to Telegram (still saved to data/proposals/).
# TELEGRAM_PROPOSALS_THREAD_ID=2
